{
  "name": "thewall-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for The Wall project",
  "scripts": {
    "dev": "pnpm --filter @theWallProject/addon dev",
    "build:common": "pnpm --filter @theWallProject/common build",
    "build:addon": "pnpm --filter @theWallProject/addon build",
    "build:chrome": "pnpm --filter @theWallProject/addon run build:chrome",
    "build:scrapper": "pnpm --filter @theWallProject/scrapper build",
    "build:telegram-bot": "pnpm --filter @theWallProject/telegram-bot build",
    "build": "pnpm build:common && pnpm build:scrapper && pnpm build:addon && pnpm build:telegram-bot && pnpm lint && pnpm format",
    "format": "prettier --write --log-level error \"**/*.{js,jsx,ts,tsx,json,md,css}\"",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "package": "pnpm --filter @theWallProject/addon run package",
    "validate": "pnpm --filter @theWallProject/scrapper validate",
    "bot:dev": "cross-env NODE_ENV=development pnpm --filter @theWallProject/telegram-bot dev",
    "bot:build": "pnpm build:common && pnpm build:telegram-bot && pnpm --filter @theWallProject/telegram-bot bot:build",
    "bot:run": "pnpm --filter @theWallProject/telegram-bot bot:run",
    "bot:logs": "pwsh -File scripts/deploy-bot.ps1 -Mode logs",
    "bot:deploy": "pwsh -File scripts/deploy-bot.ps1 -Mode deploy",
    "commit": "tsx scripts/commit.ts",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "dependencies": {
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@ianvs/prettier-plugin-sort-imports": "4.7.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.37.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "extract-gfm": "^0.1.0",
    "globals": "^15.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "3.6.2",
    "prompts": "^2.4.2",
    "tsx": "^4.20.6"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,css}": [
      "prettier --write"
    ]
  }
}
