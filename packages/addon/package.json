{
  "name": "@theWallProject/addon",
  "version": "1.15.0",
  "author": "theWall",
  "scripts": {
    "type-check": "tsc --noEmit",
    "trans": "pnpm dlx tsx TRANSLATIONS/generate.ts",
    "dev": "pnpm run pre-build && plasmo dev",
    "build": "pnpm run pre-build && pnpm run build:chrome && pnpm run build:ff && pnpm run build:ff-src",
    "build:chrome": "plasmo build --no-minify",
    "build:ff": "plasmo build --target=firefox-mv2 --no-minify",
    "build:edge": "plasmo build --target=edge-mv3 --no-minify",
    "build:opera": "plasmo build --target=opera-mv3 --no-minify",
    "build:ff-src": "node build-scripts/ff-src.js",
    "package": "pnpm run build && pnpm run package:chrome && pnpm run package:ff && pnpm run package:edge && pnpm run package:opera",
    "package:chrome": "plasmo package",
    "package:ff": "plasmo package --target=firefox-mv2",
    "package:edge": "plasmo package --target=edge-mv3",
    "package:opera": "plasmo package --target=opera-mv3",
    "pre-build": "tcm -p \"src/**/*.css\" && prettier --write \"src/**/*.css.d.ts\" \"TRANSLATIONS/**/*.ts\" && pnpm run trans && pnpm run type-check",
    "watch": "tcm -p 'src/**/*.css' -w",
    "nuke": "rm -rf node_modules build .plasmo && pnpm store prune && pnpm install",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk",
    "test:coverage-report": "vitest run --coverage && node tests/utils/coverage.ts"
  },
  "type": "module",
  "dependencies": {
    "@react-icons/all-files": "^4.1.0",
    "@theWallProject/common": "workspace:*",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.5.0",
    "svgo": "^3.0.2",
    "vite": "^7.1.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/chrome": "^0.1.24",
    "@types/node": "24.8.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sharp": "^0.32.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitest/ui": "^2.1.9",
    "archiver": "^7.0.1",
    "cross-env": "^7.0.3",
    "plasmo": "^0.90.5",
    "playwright": "^1.58.2",
    "prettier": "3.6.2",
    "sharp": "^0.34.5",
    "typed-css-modules": "^0.9.1",
    "vitest": "^2.1.9",
    "web-ext": "^9.0.0"
  },
  "manifest": {
    "default_locale": "en",
    "name": "__MSG_extensionName__",
    "description": "__MSG_extensionDescription__",
    "permissions": [
      "tabs",
      "storage"
    ],
    "web_accessible_resources": [
      {
        "resources": [
          "public/**/*.*"
        ],
        "matches": [
          "<all_urls>"
        ]
      }
    ],
    "browser_specific_settings": {
      "gecko": {
        "id": "{4df1496d-becb-4eb8-9f3e-08a52cf3dd6a}"
      }
    }
  }
}
