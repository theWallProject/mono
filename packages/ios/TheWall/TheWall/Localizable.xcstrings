    "guide.step1.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open iOS Settings"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح إعدادات iOS"
          }
        }
      }
    },
    "guide.step1.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the button below to open Settings app"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر الزر أدناه لفتح تطبيق الإعدادات"
          }
        }
      }
    },
    "guide.step2.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Navigate to Safari"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتقل إلى Safari"
          }
        }
      }
    },
    "guide.step2.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll down and tap Safari"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرّر للأسفل وانقر على Safari"
          }
        }
      }
    },
    "guide.step3.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Extensions"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح الإضافات"
          }
        }
      }
    },
    "guide.step3.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Extensions in the Safari settings"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على الإضافات في إعدادات Safari"
          }
        }
      }
    },
    "guide.step4.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable The Wall"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل الجدار"
          }
        }
      }
    },
    "guide.step4.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find The Wall in the list and toggle it on"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث عن الجدار في القائمة وقم بتفعيله"
          }
        }
      }
    },
    "guide.step5.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant Permissions"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "منح الأذونات"
          }
        }
      }
    },
    "guide.step5.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap The Wall and allow access to all websites"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على الجدار واسمح بالوصول لجميع المواقع"
          }
        }
      }
    },
