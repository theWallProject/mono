    "about.mission.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Our Mission"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مهمتنا"
          }
        }
      }
    },
    "about.mission.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Wall is a boycott assistance tool that helps identify companies involved in humanitarian violations, with a focus on the Palestinian cause. We provide transparency and alternatives to support ethical consumer choices."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجدار هو أداة مساعدة للمقاطعة تساعد في التعرّف على الشركات المتورطة في انتهاكات إنسانية، مع التركيز على القضية الفلسطينية. نوفر الشفافية والبدائل لدعم خيارات استهلاكية أخلاقية."
          }
        }
      }
    },
