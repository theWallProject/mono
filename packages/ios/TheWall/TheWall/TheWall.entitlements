<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.developer.safari-web-extension</key>
	<true/>
	<key>com.apple.developer.safari-web-extension.identifier</key>
	<string>$(AppIdentifierPrefix)com.techforpalestine.thewalladdon.ios</string>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.techforpalestine.thewalladdon</string>
	</array>
</dict>
</plist>
