# Fastfile for The Wall iOS

default_platform(:ios)

platform :ios do
  LANES_REQUIRING_CLEAN_GIT = [:beta, :release].freeze

  before_all do |lane|
    ensure_git_status_clean if LANES_REQUIRING_CLEAN_GIT.include?(lane)
  end

  # Authenticates fastlane's App Store Connect actions (pilot, deliver, precheck)
  # via the App Store Connect API key. Reads credentials from fastlane/.env.
  def load_app_store_connect_api_key
    key_id = ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"]
    key_filepath = ENV["APP_STORE_CONNECT_API_KEY_KEY_FILEPATH"]

    if key_id.nil? || issuer_id.nil? || key_filepath.nil?
      UI.user_error!(
        "Missing App Store Connect API credentials. " \
        "Copy fastlane/.env.example to fastlane/.env and fill in the values."
      )
    end

    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: File.expand_path(key_filepath),
      duration: 1200,
      in_house: false
    )
  end

  desc "Push a new beta build to TestFlight"
  desc "Usage: fastlane beta"
  lane :beta do
    load_app_store_connect_api_key

    # Increment build number
    increment_build_number(
      xcodeproj: "TheWall.xcodeproj"
    )

    # Build the app
    build_app(
      scheme: "TheWall",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "TheWall.ipa",
      clean: true,
      include_bitcode: false,
      export_options: {
        provisioningProfiles: {
          "com.techforpalestine.thewalladdon.ios" => "Mohamed Elawadi IOS app profile",
          "com.techforpalestine.thewalladdon.ios.extension" => "Mohamed Elawadi iOS extension profile"
        }
      }
    )

    # Upload to TestFlight
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      distribute_external: false,
      notify_external_testers: false
    )

    # Commit version bump
    commit_version_bump(
      message: "chore(ios): bump build number for TestFlight",
      xcodeproj: "TheWall.xcodeproj",
      force: true
    )

    # Tag build
    add_git_tag(
      grouping: "ios-beta",
      prefix: "ios/beta/",
      build_number: get_build_number(xcodeproj: "TheWall.xcodeproj")
    )

    push_to_git_remote

    UI.success("✅ Beta build uploaded to TestFlight successfully!")
    UI.message("Build number: #{get_build_number(xcodeproj: 'TheWall.xcodeproj')}")
  end

  desc "Build with current project.yml version and upload to TestFlight (no git ops, no auto-bump)"
  desc "Usage: fastlane beta_no_git"
  lane :beta_no_git do
    load_app_store_connect_api_key

    build_app(
      scheme: "TheWall",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "TheWall.ipa",
      clean: true,
      include_bitcode: false
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      distribute_external: false,
      notify_external_testers: false
    )

    UI.success("✅ Beta build uploaded to TestFlight")
  end

  desc "Upload a pre-built IPA to TestFlight (no rebuild)"
  desc "Usage: fastlane upload [ipa:path/to/TheWall.ipa]"
  lane :upload do |options|
    load_app_store_connect_api_key

    ipa_path = options[:ipa] || "./build/TheWall.ipa"
    UI.user_error!("IPA not found at #{ipa_path}") unless File.exist?(ipa_path)

    upload_to_testflight(
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      distribute_external: false,
      notify_external_testers: false
    )

    UI.success("✅ #{ipa_path} uploaded to TestFlight")
  end

  desc "Deploy a new version to the App Store"
  desc "Usage: fastlane release"
  lane :release do
    load_app_store_connect_api_key

    # Build the app
    build_app(
      scheme: "TheWall",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "TheWall.ipa",
      clean: true,
      include_bitcode: false
    )

    # Upload to App Store
    upload_to_app_store(
      submit_for_review: false,
      automatic_release: false,
      force: true,
      skip_metadata: false,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false
    )

    # Tag release
    add_git_tag(
      grouping: "ios-release",
      prefix: "ios/v",
      build_number: get_version_number(xcodeproj: "TheWall.xcodeproj")
    )

    push_to_git_remote

    UI.success("✅ Release uploaded to App Store Connect successfully!")
    UI.message("Version: #{get_version_number(xcodeproj: 'TheWall.xcodeproj')}")
    UI.message("⚠️  Remember to manually submit for review in App Store Connect")
  end

  desc "Run all tests"
  lane :test do
    run_tests(
      scheme: "TheWall",
      devices: ["iPhone 15"],
      clean: true,
      code_coverage: true
    )

    UI.success("✅ All tests passed!")
  end

  desc "Build without uploading (for CI validation)"
  lane :build_only do
    build_app(
      scheme: "TheWall",
      skip_codesigning: true,
      skip_package_ipa: true,
      configuration: "Debug",
      destination: "generic/platform=iOS Simulator"
    )

    UI.success("✅ Build successful!")
  end

  desc "Generate and upload screenshots"
  lane :screenshots do
    load_app_store_connect_api_key

    capture_screenshots(
      scheme: "TheWall",
      devices: [
        "iPhone 15 Pro Max",
        "iPhone 15",
        "iPhone SE (3rd generation)",
        "iPad Pro (12.9-inch) (6th generation)"
      ],
      languages: ["en-US", "ar"],
      clear_previous_screenshots: true,
      stop_after_first_error: false,
      test_without_building: false
    )

    upload_to_app_store(
      skip_binary_upload: true,
      skip_metadata: true,
      overwrite_screenshots: true
    )

    UI.success("✅ Screenshots captured and uploaded!")
  end

  desc "Validate App Store metadata"
  lane :validate_metadata do
    sh("bash ../scripts/validate-metadata.sh")

    UI.success("✅ Metadata validation passed!")
  end

  # Error handling
  error do |lane, exception|
    UI.error("❌ Error in lane '#{lane}': #{exception.message}")
  end
end
