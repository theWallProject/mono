# Copy to .env and fill in from App Store Connect → Users and Access → Integrations
# The .p8 file goes to ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8 (chmod 600)
APP_STORE_CONNECT_API_KEY_KEY_ID=
APP_STORE_CONNECT_API_KEY_ISSUER_ID=
APP_STORE_CONNECT_API_KEY_KEY_FILEPATH=~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8
