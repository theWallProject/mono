{
  "compilerOptions": {
    "outDir": "./dist",
    "resolveJsonModule": true,
    "module": "CommonJS",
    "target": "ESNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*"]
}
