{
  "name": "@theWallProject/scrapper",
  "version": "1.0.0",
  "description": "Puppeteer script to get data from Crunchbase",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --max-old-space-size=4096 -r ts-node/register src/index.ts",
    "data": "node --max-old-space-size=4096 -r ts-node/register src/validate_index.ts",
    "data:homepage": "node --max-old-space-size=4096 -r ts-node/register src/homepage_ai_extractor_index.ts",
    "apply-overrides": "node --max-old-space-size=4096 -r ts-node/register src/tasks/apply_overrides.ts",
    "merge": "ts-node-dev src/merge_results.ts",
    "convert": "ts-node-dev src/convertDB.ts",
    "build": "tsc && node --max-old-space-size=4096 -r ts-node/register src/tasks/regenerate_db.ts",
    "start": "pnpm run build && node --max-old-space-size=4096 dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@theWallProject/common": "workspace:*",
    "dotenv": "^16.4.7",
    "inquirer": "^12.2.0",
    "playwright": "^1.48.0",
    "puppeteer": "^24.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "prettier": "3.6.2",
    "ts-node-dev": "^2.0.0",
    "typescript-eslint": "^8.16.0",
    "vitest": "^4.0.18"
  }
}
