# Release signing configuration for The Wall Android app.
#
# Copy this file to keystore.properties and fill in your own values:
#   cp keystore.properties.template keystore.properties
#
# keystore.properties is gitignored and must never be committed.
#
# Generate a keystore first if you do not have one:
#   keytool -genkey -v -keystore ~/.android/thewall-release.keystore \
#     -alias thewall -keyalg RSA -keysize 2048 -validity 10000
#
# The build only creates a release signing config when keystore.properties
# exists, so an absent file yields an unsigned release APK rather than a failure.

# Absolute path to your keystore file.
storeFile=/absolute/path/to/thewall-release.keystore

# Password for the keystore itself.
storePassword=

# Alias of the signing key inside the keystore.
keyAlias=thewall

# Password for that key. Often the same as storePassword.
keyPassword=
