<?xml version="1.0" encoding="utf-8"?>
<!--
  Declares supported locales for Android 13+ per-app language settings.
  When adding a new language, you MUST add a <locale> entry here.
  Keep in sync with: SupportedLanguage enum in AppPreferences.kt,
  localeFilters in build.gradle.kts, and values-{lang}/strings.xml.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="ar" />
</locale-config>
