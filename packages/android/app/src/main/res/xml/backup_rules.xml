<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules for Android < 12 (API < 31)
    See https://developer.android.com/guide/topics/data/autobackup

    The Wall app doesn't store sensitive user data that needs backup.
    We exclude shared preferences for privacy.
    Valid domains: file, database, sharedpref, external, root
-->
<full-backup-content>
    <!-- Exclude shared preferences from backup -->
    <exclude domain="sharedpref" path="." />
</full-backup-content>
