{
  "name": "@theWallProject/android",
  "version": "1.0.0",
  "private": true,
  "description": "The Wall Android app",
  "scripts": {
    "build": "bash scripts/build.sh assembleDebug",
    "build:release": "bash scripts/build.sh assembleRelease",
    "release": "bash scripts/release.sh",
    "release:patch": "bash scripts/release.sh --bump patch",
    "release:minor": "bash scripts/release.sh --bump minor",
    "release:major": "bash scripts/release.sh --bump major",
    "clean": "bash scripts/build.sh clean",
    "lint": "bash scripts/build.sh lint",
    "install:prod": "bash scripts/install.sh",
    "version:bump": "bash scripts/bump-version.sh",
    "validate:metadata": "bash scripts/validate-metadata.sh",
    "adb": "bash scripts/adb.sh",
    "adb:trigger_scan": "bash scripts/adb.sh trigger_scan",
    "adb:logcat": "bash scripts/adb.sh logcat",
    "screenshots": "bash scripts/screenshots.sh",
    "screenshots:phone": "bash scripts/screenshots.sh --phone-only",
    "screenshots:tablet": "bash scripts/screenshots.sh --tablet-only",
    "screenshots:list": "bash scripts/screenshots.sh list"
  }
}
